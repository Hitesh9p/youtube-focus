{
  "manifest_version": 3,
  "name": "YouTube Focus \u2014 Stay on Task",
  "version": "0.3.0",
  "description": "Hide YouTube suggestions, Shorts and comments. Keep search and videos, with optional scroll reminders for your task.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Focus",
    "default_icon": {
      "16": "icons/owl-16.png",
      "32": "icons/owl-32.png",
      "48": "icons/owl-48.png",
      "128": "icons/owl-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/owl-16.png",
    "32": "icons/owl-32.png",
    "48": "icons/owl-48.png",
    "128": "icons/owl-128.png"
  }
}
